<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Folder</title>
</head>
<body>
    <button onclick="window.location.href='/'" ><--</button>
    <% for(let i=0;i<files.length;i++) { %>
            <a href="/file/<%=files[i].id%>"><%=files[i].originalname%></a>
            <a href="/detail/<%=files[i].id%>">Details</a>
    <%  }  %>
    <button onclick=" window.location.href='/upload/<%= folderId %>' " >Add New File</button>
</body>
</html>